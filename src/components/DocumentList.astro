---
import { listSeaweedDocuments } from "@/modules/docs/upload-seaweed";

const { documents = [], success = true } = await listSeaweedDocuments();

function formatBytes(bytes?: number) {
    if (!bytes || bytes === 0) return "0 KB";
    const k = 1024;
    const sizes = ["Bytes", "KB", "MB", "GB"];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
}
---

<div class="max-w-2xl mx-auto w-full space-y-4 mt-8" id="document-list-container">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden p-6 sm:p-8 border border-slate-200">
        
        <!-- Header -->
        <div class="flex flex-wrap items-center justify-between gap-4 pb-5 border-b border-slate-100">
            <div class="flex items-center space-x-3.5">
                <div class="p-3 bg-emerald-50 rounded-xl text-emerald-600">
                    <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-slate-900">Documentos Disponibles</h3>
                    <p class="text-xs text-slate-500">Certificados almacenados en SeaweedFS listos para verificación</p>
                </div>
            </div>

            <div class="flex items-center space-x-2">
                <span id="doc-count-badge" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                    <span id="doc-count">{documents.length}</span>&nbsp;documentos
                </span>

                <button
                    type="button"
                    id="refresh-docs-btn"
                    title="Actualizar listado"
                    class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors cursor-pointer"
                >
                    <svg id="refresh-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Barra de Búsqueda / Filtro -->
        <div class="pt-4 pb-2">
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input
                    type="text"
                    id="doc-search-input"
                    placeholder="Filtrar por nombre de alumno o ID de archivo..."
                    class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-xl text-xs sm:text-sm bg-slate-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-indigo-400 transition-all placeholder:text-slate-400"
                />
            </div>
        </div>

        <!-- Lista de Documentos -->
        <div id="documents-list" class="divide-y divide-slate-100 max-h-105 overflow-y-auto space-y-1 pr-1 custom-scrollbar">
            {documents.length > 0 ? (
                documents.map((doc) => (
                    <div
                        class="doc-item flex flex-col sm:flex-row sm:items-center justify-between p-3.5 hover:bg-slate-50/80 rounded-xl transition-all gap-3 group border border-transparent hover:border-slate-200"
                        data-name={doc.studentName.toLowerCase()}
                        data-key={doc.key.toLowerCase()}
                    >
                        <div class="flex items-start space-x-3 min-w-0">
                            <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-lg group-hover:bg-indigo-600 group-hover:text-white transition-colors shrink-0 mt-0.5 sm:mt-0">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="doc-student-name text-sm font-bold text-slate-800 group-hover:text-indigo-600 transition-colors truncate">
                                    {doc.studentName}
                                </p>
                                <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-slate-500 mt-0.5">
                                    <span class="inline-flex items-center text-slate-400">
                                        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                        <span class="doc-issue-date">{doc.issueDate}</span>
                                    </span>
                                    <span>•</span>
                                    <span class="doc-file-size font-mono text-slate-400 text-[11px]">{formatBytes(doc.fileSize)}</span>
                                </div>
                                <p class="doc-key-text text-[11px] font-mono text-slate-400 truncate mt-0.5 max-w-xs sm:max-w-sm">
                                    {doc.key}
                                </p>
                            </div>
                        </div>

                        <!-- Anchor que envía al verificador -->
                        <div class="sm:self-center shrink-0">
                            <a
                                href={`/validar?doc=${encodeURIComponent(doc.key)}`}
                                class="doc-verify-link inline-flex items-center justify-center w-full sm:w-auto px-3.5 py-2 bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white text-xs font-semibold rounded-lg border border-indigo-200 hover:border-indigo-600 shadow-xs transition-all duration-150 group-hover:shadow-sm"
                            >
                                <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                                Verificar
                            </a>
                        </div>
                    </div>
                ))
            ) : null}
        </div>

        <!-- Plantilla HTML reutilizable (Evita strings HTML en JavaScript) -->
        <template id="doc-item-template">
            <div
                class="doc-item flex flex-col sm:flex-row sm:items-center justify-between p-3.5 hover:bg-slate-50/80 rounded-xl transition-all gap-3 group border border-transparent hover:border-slate-200"
                data-name=""
                data-key=""
            >
                <div class="flex items-start space-x-3 min-w-0">
                    <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-lg group-hover:bg-indigo-600 group-hover:text-white transition-colors shrink-0 mt-0.5 sm:mt-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="doc-student-name text-sm font-bold text-slate-800 group-hover:text-indigo-600 transition-colors truncate"></p>
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-slate-500 mt-0.5">
                            <span class="inline-flex items-center text-slate-400">
                                <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span class="doc-issue-date"></span>
                            </span>
                            <span>•</span>
                            <span class="doc-file-size font-mono text-slate-400 text-[11px]"></span>
                        </div>
                        <p class="doc-key-text text-[11px] font-mono text-slate-400 truncate mt-0.5 max-w-xs sm:max-w-sm"></p>
                    </div>
                </div>

                <div class="sm:self-center shrink-0">
                    <a
                        href="#"
                        class="doc-verify-link inline-flex items-center justify-center w-full sm:w-auto px-3.5 py-2 bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white text-xs font-semibold rounded-lg border border-indigo-200 hover:border-indigo-600 shadow-xs transition-all duration-150 group-hover:shadow-sm"
                    >
                        <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        Verificar
                    </a>
                </div>
            </div>
        </template>

        <!-- Estado Vacío -->
        <div id="empty-state" class={`${documents.length > 0 ? "hidden" : ""} text-center py-10 px-4 space-y-3`}>
            <div class="w-12 h-12 mx-auto bg-slate-100 text-slate-400 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                </svg>
            </div>
            <p class="text-sm font-medium text-slate-600">No hay documentos disponibles aún</p>
            <p class="text-xs text-slate-400 max-w-xs mx-auto">
                Genera un nuevo diploma con el formulario superior para verlo listado aquí.
            </p>
        </div>

        <!-- Sin resultados de búsqueda -->
        <div id="no-search-results" class="hidden text-center py-8 px-4 space-y-2">
            <p class="text-sm font-medium text-slate-600">No se encontraron documentos coincidentes</p>
            <p class="text-xs text-slate-400">Intenta con otro término de búsqueda</p>
        </div>

    </div>
</div>

<script>
    import { actions } from "astro:actions";

    const docList = document.getElementById("documents-list");
    const docCount = document.getElementById("doc-count");
    const emptyState = document.getElementById("empty-state");
    const noSearchResults = document.getElementById("no-search-results");
    const searchInput = document.getElementById("doc-search-input") as HTMLInputElement | null;
    const refreshBtn = document.getElementById("refresh-docs-btn");
    const refreshIcon = document.getElementById("refresh-icon");
    const itemTemplate = document.getElementById("doc-item-template") as HTMLTemplateElement | null;

    function formatBytes(bytes?: number): string {
        if (!bytes || bytes === 0) return "0 KB";
        const k = 1024;
        const sizes = ["Bytes", "KB", "MB", "GB"];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
    }

    function createDocumentNode(doc: {
        key: string;
        studentName: string;
        issueDate: string;
        fileSize?: number;
    }): DocumentFragment | null {
        if (!itemTemplate) return null;

        const clone = itemTemplate.content.cloneNode(true) as DocumentFragment;
        const root = clone.querySelector<HTMLElement>(".doc-item");
        const nameEl = clone.querySelector<HTMLElement>(".doc-student-name");
        const dateEl = clone.querySelector<HTMLElement>(".doc-issue-date");
        const sizeEl = clone.querySelector<HTMLElement>(".doc-file-size");
        const keyEl = clone.querySelector<HTMLElement>(".doc-key-text");
        const linkEl = clone.querySelector<HTMLAnchorElement>(".doc-verify-link");

        if (root) {
            root.setAttribute("data-name", doc.studentName.toLowerCase());
            root.setAttribute("data-key", doc.key.toLowerCase());
        }
        if (nameEl) nameEl.textContent = doc.studentName;
        if (dateEl) dateEl.textContent = doc.issueDate;
        if (sizeEl) sizeEl.textContent = formatBytes(doc.fileSize);
        if (keyEl) keyEl.textContent = doc.key;
        if (linkEl) linkEl.href = `/validar?doc=${encodeURIComponent(doc.key)}`;

        return clone;
    }

    async function loadDocuments() {
        if (refreshIcon) refreshIcon.classList.add("animate-spin");

        try {
            const { data, error } = await actions.listDocuments();
            if (error || !data || !data.documents) {
                console.error("Error al obtener documentos:", error);
                return;
            }

            const docs = data.documents;

            if (docCount) docCount.textContent = docs.length.toString();

            if (docList) {
                if (docs.length === 0) {
                    docList.innerHTML = "";
                    if (emptyState) emptyState.classList.remove("hidden");
                } else {
                    if (emptyState) emptyState.classList.add("hidden");
                    
                    docList.innerHTML = "";
                    const fragment = document.createDocumentFragment();
                    docs.forEach((doc) => {
                        const node = createDocumentNode(doc);
                        if (node) fragment.appendChild(node);
                    });
                    docList.appendChild(fragment);

                    filterDocs();
                }
            }
        } catch (err) {
            console.error("Error en loadDocuments:", err);
        } finally {
            if (refreshIcon) refreshIcon.classList.remove("animate-spin");
        }
    }

    function filterDocs() {
        const query = searchInput?.value.toLowerCase().trim() || "";
        const items = docList?.querySelectorAll<HTMLElement>(".doc-item") || [];
        let visibleCount = 0;

        items.forEach((item) => {
            const name = item.getAttribute("data-name") || "";
            const key = item.getAttribute("data-key") || "";

            if (!query || name.includes(query) || key.includes(query)) {
                item.style.display = "";
                visibleCount++;
            } else {
                item.style.display = "none";
            }
        });

        if (items.length > 0 && visibleCount === 0 && query) {
            noSearchResults?.classList.remove("hidden");
        } else {
            noSearchResults?.classList.add("hidden");
        }
    }

    searchInput?.addEventListener("input", filterDocs);
    refreshBtn?.addEventListener("click", loadDocuments);

    // Actualizar automáticamente cuando se genera un certificado
    window.addEventListener("document-created", () => {
        loadDocuments();
    });
</script>
