---
import Layout from "@/layouts/Layout.astro";
import GenerateDoc from "@/components/GenerateDoc.astro";
import DocumentList from "@/components/DocumentList.astro";
---

<Layout>
	<main class="min-h-screen flex flex-col justify-start items-center py-12 px-4 sm:px-6 lg:px-8">
		<div class="text-center mb-8 space-y-2">
			<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-700">
				SeaweedFS + S3 Presigned URLs Demo
			</span>
			<h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">
				Certificación & Validación Digital
			</h1>
			<p class="text-slate-600 max-w-md mx-auto text-sm">
				Genera diplomas con código QR de verificación y acceso temporal seguro mediante URLs firmadas.
			</p>
		</div>
		<GenerateDoc />
		<DocumentList />
	</main>
</Layout>
